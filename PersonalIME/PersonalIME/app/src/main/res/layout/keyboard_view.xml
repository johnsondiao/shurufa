<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg_light">

    <!-- 顶部工具栏（仿微信输入法）：右侧功能图标（剪贴板/表情/隐私/设置） -->
    <LinearLayout
        android:id="@+id/keyboardToolbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/candidate_bg_light"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp" />

    <!-- 拼音回显行（独立一行，位于候选字上一行；长句单行省略） -->
    <TextView
        android:id="@+id/pinyinDisplay"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@color/candidate_bg_light"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1E8E3E"
        android:visibility="gone" />

    <!-- 候选字行（单独一行，横向滚动） -->
    <HorizontalScrollView
        android:id="@+id/candidateScrollView"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/candidate_bg_light"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/candidateLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- 键盘区域（左侧拼音选择列 + 右侧按键） -->
    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- 左侧拼音选择列（可滚动，高度对齐键盘，避免撑高键盘） -->
        <ScrollView
            android:id="@+id/pinyinSelectorScroll"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:background="#E8E8E8"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pinyinSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 右侧键盘 -->
        <LinearLayout
            android:id="@+id/keyboardArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
